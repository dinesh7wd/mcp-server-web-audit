# Logging level (trace, debug, info, warn, error, fatal, silent). Logs go to stderr.
LOG_LEVEL=info

# Transport: stdio (local MCP clients) | http (Streamable HTTP, stateless)
TRANSPORT=stdio

# --- HTTP transport (TRANSPORT=http) ---
# Required, at least 32 characters (e.g. `openssl rand -hex 32`)
# MCP_AUTH_TOKEN=
# PORT=3100
# Bind address. Defaults to loopback; set 0.0.0.0 only behind a reverse proxy / in containers.
# HOST=127.0.0.1
# Allowed Host header hostnames (DNS-rebinding protection). Required when HOST is not loopback.
# MCP_ALLOWED_HOSTS=audit.example.com
# Browser origins allowed to call /mcp (CORS). Empty = browser requests with an Origin header are rejected.
# MCP_ALLOWED_ORIGINS=https://app.example.com
# Express "trust proxy" setting (false | true | hop count | loopback, ...). Needed for correct per-IP limits behind a proxy.
# TRUST_PROXY=false
# Per-IP request limit and stricter per-IP failed-auth limit (per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
AUTH_FAIL_RATE_LIMIT_MAX=10

# --- Network ---
# Per-request timeout (max 30000) and overall per-tool-call deadline (DNS + fetch + CrUX)
AUDIT_TIMEOUT_MS=15000
AUDIT_TOTAL_TIMEOUT_MS=45000
AUDIT_MAX_REDIRECTS=5
# Defaults to mcp-server-web-audit/<version>
# AUDIT_USER_AGENT=
# Check robots.txt before auditing (off by default: this is a user-directed single-page auditor, not a crawler)
RESPECT_ROBOTS_TXT=false

# Optional Chrome UX Report API key for real-user Core Web Vitals (sent via X-Goog-Api-Key header)
# CRUX_API_KEY=

# --- In-memory cache ---
AUDIT_CACHE_TTL_MS=300000
AUDIT_CACHE_MAX_ENTRIES=100

# --- Domain policies (comma-separated). Empty allowlist = any public domain ---
AUDIT_ALLOWED_DOMAINS=
AUDIT_BLOCKED_DOMAINS=
# Ports audits (and redirects) may target. Default 80,443,8080,8443; "*" allows any port.
AUDIT_ALLOWED_PORTS=
